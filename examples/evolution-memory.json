{
  "version": 1,
  "id": "normalize-numbers",
  "title": "数字数组规范化",
  "keywords": ["数字数组", "去重排序"],
  "runtime": "memory",
  "auto": false,
  "seed": {
    "title": "读取并规范化数字数组",
    "preconditions": ["input.json 是由有限数字组成的 JSON 数组"],
    "steps": ["读取 input.json", "按任务要求处理数组，写入 result.json"],
    "checks": ["result.json 是有效 JSON 数组"],
    "counterexamples": ["含非数字值时此方法不适用"]
  },
  "cases": [
    {"id":"duplicate","split":"train","input":"读取 input.json，按数值升序排序并去重，将 JSON 数组写入 result.json。","files":{"input.json":"[2,2,3]"},"checks":[{"target":"file","path":"result.json","kind":"jsonEquals","expected":[2,3]}]},
    {"id":"numeric","split":"train","input":"读取 input.json，按数值升序排序并去重，将 JSON 数组写入 result.json。","files":{"input.json":"[10,2]"},"checks":[{"target":"file","path":"result.json","kind":"jsonEquals","expected":[2,10]}]},
    {"id":"negative","split":"validation","input":"读取 input.json，按数值升序排序并去重，将 JSON 数组写入 result.json。","files":{"input.json":"[30,4,4,-2]"},"checks":[{"target":"file","path":"result.json","kind":"jsonEquals","expected":[-2,4,30]}]},
    {"id":"combined","split":"validation","input":"读取 input.json，按数值升序排序并去重，将 JSON 数组写入 result.json。","files":{"input.json":"[12,5,12,1]"},"checks":[{"target":"file","path":"result.json","kind":"jsonEquals","expected":[1,5,12]}]}
  ]
}
