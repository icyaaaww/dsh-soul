{
  "name": "dsh-soul",
  "version": "0.8.1",
  "description": "Standalone DSH harness evolution: observed divergence, worktree probes, trial adoption and rollback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icyaaaww/dsh-soul.git"
  },
  "homepage": "https://github.com/icyaaaww/dsh-soul#readme",
  "bugs": {
    "url": "https://github.com/icyaaaww/dsh-soul/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "src/*.js",
    "harness/default/*.md",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node --check index.js && npm test",
    "demo": "node scripts/demo.mjs",
    "test:host": "node scripts/test-host.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "evolution"
  ]
}
