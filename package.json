{
  "name": "dsh-soul",
  "version": "2.1.0",
  "description": "Memory skeleton and graph compaction for DSH: recover what compression removed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icyaaaww/dsh-soul.git"
  },
  "homepage": "https://github.com/icyaaaww/dsh-soul#readme",
  "bugs": {
    "url": "https://github.com/icyaaaww/dsh-soul/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./compaction": "./compaction.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "compaction.js",
    "src/*.js",
    "harness/default/*.md",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node --check index.js && npm test",
    "demo": "node scripts/demo.mjs",
    "bench": "node bench/compaction-loss.mjs",
    "bench:memory": "node bench/replay.mjs",
    "bench:graph": "node bench/graph-memory.mjs",
    "bench:continuation": "node bench/continuation.mjs",
    "bench:consolidation": "node bench/consolidation.mjs",
    "test:dynamics": "node --test tests/graph-memory.test.mjs tests/neuro.test.mjs",
    "test:graph": "node --test tests/graph-memory.test.mjs",
    "test:projection": "node --test tests/projection.test.mjs tests/mem-command.test.mjs",
    "demo:memory": "node scripts/memory-demo.mjs",
    "demo:compaction": "node scripts/compaction-demo.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:compaction-host": "node --test tests/compaction-host.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "evolution"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    }
  }
}
